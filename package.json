{
  "name": "phphtmledit-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/phphtmledit/editor.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run vendor:tinymce && vite --host 127.0.0.1",
    "dev:e0": "npm run vendor:tinymce && vite --mode e0 --host 127.0.0.1",
    "build": "npm run vendor:tinymce && vite build",
    "build:e0": "npm run build && vite build --mode e0 && npm run e4:dark-assets-removal && npm run e0:build-boundary && npm run e3:mammoth-reduction",
    "preview:e0": "vite preview --mode e0 --host 127.0.0.1",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "vendor:tinymce": "node scripts/copy-tinymce.mjs",
    "e0:build-boundary": "node scripts/check-build-boundary.mjs",
    "e0:docx": "node scripts/check-docx.mjs",
    "e3:mammoth-reduction": "node scripts/measure-mammoth-reduction.mjs",
    "e4:dark-assets-removal": "node scripts/measure-dark-assets-removal.mjs",
    "legal": "node scripts/check-legal-comments.mjs && node scripts/check-notices-delivery.mjs",
    "icons": "node scripts/check-icon-visual.mjs",
    "size": "node scripts/check-size.mjs",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/html": "1.3.13",
    "mammoth": "1.12.1",
    "tinymce": "8.8.2",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
